{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Copilot",
  "identifier": "dev.stockcopilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm exec vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "Stock Copilot",
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc:; worker-src 'none'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMDk4NTk1MjY5N0U2M0YKUldRLzVwY21sWVVKdzFyZk9NS1RCaTBGVURyYVNMQzFvcENhS1gzOFVMRzhJbkhJUDhCeE5Yc0wK",
      "endpoints": [
        "https://github.com/gihwan-dev/stock-copilot/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
