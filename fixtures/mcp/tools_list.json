  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Submit a probability estimate for one task: task_id, integer p from 1 to 99, rationale, strongest counterargument, and sources as tool:<request id> of successful calls in this run. This records an estimate only; it never creates an order. The app decides any signal.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "counterargument": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "p": {
          "maximum": 99,
          "minimum": 1,
          "type": "integer"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "sources": {
          "items": {
            "maxLength": 128,
            "pattern": "^tool:",
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "p",
        "rationale",
        "counterargument",
        "sources"
      ],
      "type": "object"
    },
    "name": "submit_estimate"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Propose claim-level changes to the thesis note of one app-known symbol against base_version from get_thesis. Evidence is tool:<name>, a collected item handle, or a web address; changes backed only by web addresses wait for user review. History is kept.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "base_version": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        "changes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "claim_id": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "criterion": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "evidence": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "tool",
                        "collected",
                        "web"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "type": "object"
                },
                "maxItems": 8,
                "minItems": 1,
                "type": "array"
              },
              "expected": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "metric": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "observe_via": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "enum": [
                  "add_claim",
                  "judge_claim",
                  "add_kill_criterion",
                  "judge_kill_criterion"
                ],
                "type": "string"
              },
              "reason": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "refutation": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "enum": [
                  "core",
                  "supporting"
                ],
                "type": "string"
              },
              "statement": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "intact",
                  "weakened",
                  "broken",
                  "unverifiable",
                  "met",
                  "not_met"
                ],
                "type": "string"
              }
            },
            "required": [
              "op",
              "claim_id",
              "reason",
              "evidence"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "symbol": {
          "maxLength": 12,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "base_version",
        "changes"
      ],
      "type": "object"
    },
    "name": "update_thesis"
  }
]
