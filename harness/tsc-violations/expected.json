{
  "include": ["src"],
  "otherOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true
  },
  "options": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "libReplacement": false,
    "types": [],
    "skipLibCheck": false,
    "allowJs": false,
    "checkJs": false
  },
  "cases": {
    "cases/allow-unreachable-code.ts": ["TS7027"],
    "cases/allow-unused-labels.ts": ["TS7028"],
    "cases/always-strict.ts": ["TS1212"],
    "cases/erasable-syntax-only.ts": ["TS1294"],
    "cases/exact-optional-property-types.ts": ["TS2375"],
    "cases/force-consistent-casing-in-file-names.ts": ["TS1261"],
    "cases/implicit-any.ts": ["TS7006"],
    "cases/isolated-modules.ts": ["TS1205"],
    "cases/no-fallthrough-cases-in-switch.ts": ["TS7029"],
    "cases/no-implicit-override.ts": ["TS4114"],
    "cases/no-implicit-returns.ts": ["TS7030"],
    "cases/no-implicit-this.ts": ["TS2683"],
    "cases/no-property-access-from-index-signature.ts": ["TS4111"],
    "cases/no-unchecked-indexed-access.ts": ["TS2322"],
    "cases/no-unchecked-side-effect-imports.ts": ["TS2882"],
    "cases/no-unused-locals.ts": ["TS6133"],
    "cases/no-unused-parameters.ts": ["TS6133"],
    "cases/strict-bind-call-apply.ts": ["TS2345"],
    "cases/strict-builtin-iterator-return.ts": ["TS2322"],
    "cases/strict-function-types.ts": ["TS2322"],
    "cases/strict-null-checks.ts": ["TS18047"],
    "cases/strict-property-initialization.ts": ["TS2564"],
    "cases/use-unknown-in-catch-variables.ts": ["TS18046"],
    "cases/verbatim-module-syntax.ts": ["TS1484"],
    "support/casing-target.ts": [],
    "support/shape.ts": []
  }
}
