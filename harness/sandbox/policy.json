{
  "now": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "index.crates.io",
        "static.crates.io"
      ],
      "allowLocalBinding": true,
      "allowUnixSockets": ["/private/tmp/claude-501"]
    },
    "filesystem": {
      "allowWrite": [
        "../stock-copilot-wt",
        "~/.cargo/registry",
        "~/.cargo/advisory-dbs/db.lock",
        "~/Library/pnpm/store",
        "~/Library/pnpm/_tmp_*",
        "~/Library/pnpm/_tmp_*/*",
        "/private/tmp/pnpm-store-operation-locks-501",
        "/private/tmp/pnpm-dir-locks-501",
        "/private/tmp/pnpm-modules-swaps-501"
      ],
      "denyWrite": [
        "./.cargo/config",
        "./.cargo/config.toml",
        "../stock-copilot-wt/.cargo",
        "../stock-copilot-wt/*/.cargo/config",
        "../stock-copilot-wt/*/.cargo/config.toml",
        "./.git/info",
        "~/.cargo/registry/src",
        "~/.gitconfig",
        "~/.config/git",
        "~/.claude",
        "~/.rustup/settings.toml",
        "~/.cargo/config",
        "~/.cargo/config.toml",
        "~/.local/state/stock-copilot-harness"
      ]
    }
  },
  "lock": {
    "keepWritable": [".claude/worktrees/**"],
    "newPaths": [
      "*.yml",
      "*.json",
      "*.js",
      "*.mjs",
      "*.cjs",
      "*.ts",
      ".github",
      ".mcp.json",
      ".worktreeinclude",
      ".gitattributes",
      ".editorconfig",
      ".tool-versions",
      ".nvmrc",
      ".env*",
      ".lefthook*",
      "lefthook-local.yml",
      ".claude/settings*.json",
      ".claude/skills",
      ".claude/commands"
    ]
  }
}
