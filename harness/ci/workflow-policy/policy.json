{
  "topKeys": ["name", "on", "permissions", "jobs"],
  "events": {
    "push": ["branches"],
    "pull_request": ["branches"],
    "schedule": [],
    "workflow_dispatch": ["inputs"]
  },
  "schedules": ["0 18 * * *", "0 14 * * 0"],
  "jobKeys": [
    "runs-on",
    "timeout-minutes",
    "steps",
    "needs",
    "if",
    "permissions",
    "outputs"
  ],
  "requiredJobKeys": ["runs-on", "timeout-minutes", "steps"],
  "stepKeys": [
    "name",
    "id",
    "uses",
    "with",
    "run",
    "env",
    "if",
    "timeout-minutes"
  ],
  "runners": ["ubuntu-24.04-arm", "ubuntu-24.04", "macos-15"],
  "maxTimeout": 180,
  "permissions": {
    "contents": "read"
  },
  "jobPermissions": {
    ".github/workflows/ci.yml#notify": {
      "issues": "write"
    },
    ".github/workflows/nightly.yml#notify": {
      "issues": "write"
    },
    ".github/workflows/signatures.yml#notify": {
      "issues": "write"
    },
    ".github/workflows/signatures.yml#signatures": {
      "contents": "read",
      "actions": "read"
    },
    ".github/workflows/nightly.yml#notify-mutants": {
      "issues": "write"
    },
    ".github/workflows/nightly.yml#daily-plan": {
      "contents": "read",
      "actions": "read"
    }
  },
  "conditions": [
    "failure()",
    "github.event_name == 'push' && github.ref == 'refs/heads/master'",
    "github.event_name == 'push' && github.ref != 'refs/heads/master'",
    "failure() && github.event_name == 'push' && github.ref == 'refs/heads/master'",
    "hashFiles('base-tools/harness/ci/notify.mjs') != ''",
    "hashFiles('base-tools/harness/ci/notify.mjs') == ''",
    "hashFiles('base-tools/harness/ci/signatures/from-base.mjs') != ''",
    "hashFiles('base-tools/harness/ci/signatures/from-base.mjs') == ''",
    "needs.changes.outputs.changed == 'yes'",
    "github.event.schedule == '0 14 * * 0' || (github.event_name == 'workflow_dispatch' && inputs.mode == 'full')",
    "github.event.schedule == '0 18 * * *' || (github.event_name == 'workflow_dispatch' && inputs.mode == 'daily')",
    "github.event.schedule == '0 18 * * *'",
    "github.event.schedule == '0 18 * * *' && needs.changes.outputs.changed == 'yes'",
    "failure() && github.event.schedule == '0 18 * * *'"
  ],
  "commands": [
    "echo '서명 검사 비활성: 기준 checkout에 harness/ci/signatures/from-base.mjs가 없다'",
    "echo '알림 없음: 기준 checkout에 harness/ci/notify.mjs가 없다'",
    "just advisory-db-fetch",
    "just base=\"$BASE\" check",
    "just base=HEAD check",
    "just linux-check",
    "lefthook install",
    "node base-tools/harness/ci/notify.mjs",
    "node base-tools/harness/ci/signatures/from-base.mjs \"$GITHUB_WORKSPACE\" \"$HEAD\" --range-start \"$RANGE_START\" --base-kind \"$BASE_KIND\"",
    "node harness/ci/ci-range.mjs base",
    "node harness/ci/ci-range.mjs changed",
    "node harness/ci/linux/offline.mjs just linux-test",
    "node harness/ci/tools.mjs cargo-install",
    "node harness/ci/tools.mjs fetch",
    "node harness/ci/tools.mjs lefthook",
    "node harness/ci/tools.mjs pnpm",
    "set -euo pipefail\ngh api \"repos/$GITHUB_REPOSITORY/actions/workflows/signatures.yml/runs?branch=master&event=push&status=success&per_page=100\" --jq '.workflow_runs[].head_sha' > \"$RUNNER_TEMP/verified-runs\"\nmaster_push=no\nif [ \"$EVENT_NAME\" = push ] && [ \"$REF\" = refs/heads/master ]; then master_push=yes; fi\nverified=''\nwhile read -r sha; do if git cat-file -e \"$sha^{commit}\" 2>/dev/null && { [ \"$master_push\" = no ] || git merge-base --is-ancestor \"$sha\" \"$HEAD\"; }; then verified=\"$sha\"; break; fi; done < \"$RUNNER_TEMP/verified-runs\"\nkind=verified\nif [ -z \"$verified\" ]; then if [ -s \"$RUNNER_TEMP/verified-runs\" ]; then echo '서명 검사가 통과한 master 커밋 가운데 기준이 될 것이 없다' >&2; exit 1; fi; kind=unverified; if [ \"$master_push\" = yes ]; then verified=\"$BEFORE\"; else verified=\"$(git rev-parse refs/remotes/origin/master)\"; fi; fi\nif [ \"$master_push\" = yes ]; then base=\"$verified\"; else base=\"$(git merge-base \"$verified\" \"$HEAD\")\"; fi\nprintf '서명 검사 신뢰 자료 %s, 범위 시작 %s (%s)\\n' \"$verified\" \"$base\" \"$kind\"\nprintf 'tools=%s\\nbase=%s\\nkind=%s\\n' \"$verified\" \"$base\" \"$kind\" >> \"$GITHUB_OUTPUT\"",
    "just mutants-shard ${{ matrix.shard }}",
    "node harness/ci/mutants-summary.mjs",
    "node harness/ci/mutation-range.mjs plan",
    "just mutants-daily \"$MUTATION_BASE\" \"$MUTATION_SHARD\"",
    "node harness/ci/mutation-range.mjs verify",
    "node harness/ci/visual.mjs",
    "node harness/ci/diff-mutants.mjs",
    "node harness/ci/diff-mutants-verdict.mjs",
    "node harness/ci/branch-checkout.mjs"
  ],
  "expressions": [
    "${{ github.event.before }}",
    "${{ github.event.pull_request.base.sha }}",
    "${{ github.event.pull_request.head.sha || github.sha }}",
    "${{ github.event.pull_request.head.sha }}",
    "${{ github.event_name }}",
    "${{ github.ref }}",
    "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}",
    "${{ github.sha }}",
    "${{ github.token }}",
    "${{ steps.base.outputs.base }}",
    "${{ steps.base.outputs.kind }}",
    "${{ steps.base.outputs.tools }}",
    "${{ steps.changed.outputs.changed }}",
    "${{ steps.range.outputs.base }}",
    "${{ steps.mutation.outcome }}",
    "${{ matrix.shard }}",
    "${{ steps.plan.outputs.base }}",
    "${{ steps.plan.outputs.shards }}",
    "${{ steps.plan.outputs.count }}",
    "${{ steps.plan.outputs.anchor }}",
    "${{ steps.plan.outcome }}",
    "${{ needs.daily-plan.outputs.base }}",
    "${{ steps.mutation.outputs.status }}"
  ],
  "envNames": [
    "BASE",
    "BASE_KIND",
    "BEFORE",
    "EVENT_NAME",
    "GH_TOKEN",
    "HEAD",
    "PR_BASE",
    "PR_HEAD",
    "RANGE_START",
    "REF",
    "RUN_URL",
    "SHA",
    "TITLE",
    "MUTATION_OUTCOME",
    "MUTATION_SHARD",
    "MUTATION_BASE",
    "MUTATION_MODE",
    "MUTATION_STATUS"
  ],
  "inputValues": {
    "fetch-depth": [0, 1],
    "persist-credentials": [false],
    "node-version-file": [".node-version", "base-tools/.node-version"],
    "ref": [
      "${{ github.event.before }}",
      "master",
      "${{ steps.base.outputs.tools }}",
      "${{ needs.signatures.outputs.tools }}",
      "${{ github.sha }}"
    ],
    "path": ["base-tools"]
  },
  "actions": {
    "actions/checkout": {
      "sha": "3d3c42e5aac5ba805825da76410c181273ba90b1",
      "inputs": ["fetch-depth", "persist-credentials", "ref", "path"]
    },
    "actions/setup-node": {
      "sha": "949feb2413d6458794dcd2491c4babbbce0c15c1",
      "inputs": ["node-version-file"]
    },
    "taiki-e/install-action": {
      "sha": "cfdb7ed4ccc7c7dce37759eae89dc5674b469b39",
      "inputs": ["tool"]
    }
  },
  "checkout": "actions/checkout",
  "toolInstaller": "taiki-e/install-action",
  "expected": {
    ".github/workflows/ci.yml": {
      "name": "ci",
      "on": {
        "push": {
          "branches": ["**"]
        },
        "pull_request": {
          "branches": ["master"]
