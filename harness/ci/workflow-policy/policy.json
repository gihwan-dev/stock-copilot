{
  "topKeys": ["name", "on", "permissions", "jobs"],
  "events": {
    "push": ["branches"],
    "pull_request": ["branches"],
    "schedule": []
  },
  "schedules": ["0 18 * * *"],
  "jobKeys": [
    "runs-on",
    "timeout-minutes",
    "steps",
    "needs",
    "if",
    "permissions",
    "outputs"
  ],
  "requiredJobKeys": ["runs-on", "timeout-minutes", "steps"],
  "stepKeys": ["name", "id", "uses", "with", "run", "env", "if"],
  "runners": ["ubuntu-24.04-arm", "ubuntu-24.04", "macos-15"],
  "maxTimeout": 180,
  "permissions": {
    "contents": "read"
  },
  "jobPermissions": {
    ".github/workflows/ci.yml#notify": {
      "issues": "write"
    },
    ".github/workflows/nightly.yml#notify": {
      "issues": "write"
    },
    ".github/workflows/signatures.yml#notify": {
      "issues": "write"
    },
    ".github/workflows/signatures.yml#signatures": {
      "contents": "read",
      "actions": "read"
    }
  },
  "conditions": [
    "failure()",
    "failure() && github.event_name == 'push' && github.ref == 'refs/heads/master'",
    "github.event_name == 'push' && github.ref == 'refs/heads/master'",
    "hashFiles('base-tools/harness/ci/notify.mjs') != ''",
    "hashFiles('base-tools/harness/ci/notify.mjs') == ''",
    "hashFiles('base-tools/harness/ci/signatures/from-base.mjs') != ''",
    "hashFiles('base-tools/harness/ci/signatures/from-base.mjs') == ''",
    "needs.changes.outputs.changed == 'yes'"
  ],
  "commands": [
    "corepack enable",
    "echo '서명 검사 비활성: 기준 checkout에 harness/ci/signatures/from-base.mjs가 없다'",
    "echo '알림 없음: 기준 checkout에 harness/ci/notify.mjs가 없다'",
    "just advisory-db-fetch",
    "just base=\"$BASE\" check",
    "just base=HEAD check",
    "just linux-check",
    "lefthook install",
    "node base-tools/harness/ci/notify.mjs",
    "node base-tools/harness/ci/signatures/from-base.mjs \"$GITHUB_WORKSPACE\" \"$HEAD\"",
    "node harness/ci/ci-range.mjs base",
    "node harness/ci/ci-range.mjs changed",
    "node harness/ci/linux/offline.mjs just linux-test",
    "node harness/ci/linux/offline.mjs just mutants-all",
    "node harness/ci/tools.mjs cargo-install",
    "node harness/ci/tools.mjs fetch",
    "node harness/ci/tools.mjs lefthook",
    "set -euo pipefail\ngh api \"repos/$GITHUB_REPOSITORY/actions/workflows/signatures.yml/runs?branch=master&event=push&status=success&per_page=100\" --jq '.workflow_runs[].head_sha' > \"$RUNNER_TEMP/verified-runs\"\nmaster_push=no\nif [ \"$EVENT_NAME\" = push ] && [ \"$REF\" = refs/heads/master ]; then master_push=yes; fi\nverified=''\nwhile read -r sha; do if git cat-file -e \"$sha^{commit}\" 2>/dev/null && { [ \"$master_push\" = no ] || git merge-base --is-ancestor \"$sha\" \"$HEAD\"; }; then verified=\"$sha\"; break; fi; done < \"$RUNNER_TEMP/verified-runs\"\nkind=verified\nif [ -z \"$verified\" ]; then if [ -s \"$RUNNER_TEMP/verified-runs\" ]; then echo '서명 검사가 통과한 master 커밋 가운데 기준이 될 것이 없다' >&2; exit 1; fi; kind=unverified; if [ \"$master_push\" = yes ]; then verified=\"$BEFORE\"; else verified=\"$(git rev-parse refs/remotes/origin/master)\"; fi; fi\nif [ \"$master_push\" = yes ]; then base=\"$verified\"; else base=\"$(git merge-base \"$verified\" \"$HEAD\")\"; fi\nprintf '서명 검사 기준 %s (%s)\\n' \"$base\" \"$kind\"\nprintf 'base=%s\\nkind=%s\\n' \"$base\" \"$kind\" >> \"$GITHUB_OUTPUT\""
  ],
  "expressions": [
    "${{ github.event.before }}",
    "${{ github.event.pull_request.base.sha }}",
    "${{ github.event.pull_request.head.sha || github.sha }}",
    "${{ github.event.pull_request.head.sha }}",
    "${{ github.event_name }}",
    "${{ github.ref }}",
    "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}",
    "${{ github.sha }}",
    "${{ github.token }}",
    "${{ steps.base.outputs.base }}",
    "${{ steps.base.outputs.kind }}",
    "${{ steps.changed.outputs.changed }}",
    "${{ steps.range.outputs.base }}"
  ],
  "envNames": [
    "BASE",
    "BEFORE",
    "EVENT_NAME",
    "GH_TOKEN",
    "HEAD",
    "PR_BASE",
    "PR_HEAD",
    "REF",
    "RUN_URL",
    "SHA",
    "SIGNATURE_BASE_KIND",
    "TITLE"
  ],
  "inputValues": {
    "fetch-depth": [0, 1],
    "persist-credentials": [false],
    "node-version-file": [".node-version", "base-tools/.node-version"],
    "ref": [
      "${{ github.event.before }}",
      "master",
      "${{ steps.base.outputs.base }}",
      "${{ needs.signatures.outputs.base }}"
    ],
    "path": ["base-tools"]
  },
  "actions": {
    "actions/checkout": {
      "sha": "3d3c42e5aac5ba805825da76410c181273ba90b1",
      "inputs": ["fetch-depth", "persist-credentials", "ref", "path"]
    },
    "actions/setup-node": {
      "sha": "949feb2413d6458794dcd2491c4babbbce0c15c1",
      "inputs": ["node-version-file"]
    },
    "taiki-e/install-action": {
      "sha": "cfdb7ed4ccc7c7dce37759eae89dc5674b469b39",
      "inputs": ["tool"]
    }
  },
  "checkout": "actions/checkout",
  "toolInstaller": "taiki-e/install-action",
  "expected": {
    ".github/workflows/ci.yml": {
      "name": "ci",
      "on": {
        "push": {
          "branches": ["**"]
        },
        "pull_request": {
          "branches": ["master"]
        }
      },
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "linux": {
          "runs-on": "ubuntu-24.04-arm",
          "timeout-minutes": 60,
          "steps": [
            {
              "name": "checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "fetch-depth": 0,
                "persist-credentials": false
              }
            },
            {
              "name": "node",
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version-file": ".node-version"
              }
            },
            {
              "name": "pnpm",
              "run": "corepack enable"
            },
            {
              "name": "tools",
              "uses": "taiki-e/install-action@cfdb7ed4ccc7c7dce37759eae89dc5674b469b39",
              "with": {
                "tool": "just@1.59.0,cargo-nextest@0.9.151,cargo-deny@0.20.2,cargo-llvm-cov@0.9.1"
              }
            },
            {
              "name": "cargo-mutants",
              "run": "node harness/ci/tools.mjs cargo-install"
            },
            {
              "name": "lefthook",
              "run": "node harness/ci/tools.mjs lefthook"
            },
            {
              "name": "fetch",
              "run": "node harness/ci/tools.mjs fetch"
            },
            {
              "name": "advisory db",
              "run": "just advisory-db-fetch"
            },
            {
              "name": "linux check",
              "run": "just linux-check"
            },
            {
              "name": "linux tests without network",
              "run": "node harness/ci/linux/offline.mjs just linux-test"
            }
          ]
        },
        "macos": {
          "if": "github.event_name == 'push' && github.ref == 'refs/heads/master'",
          "runs-on": "macos-15",
          "timeout-minutes": 90,
          "steps": [
            {
              "name": "checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "fetch-depth": 0,
                "persist-credentials": false
              }
            },
            {
              "name": "node",
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version-file": ".node-version"
              }
            },
            {
              "name": "pnpm",
              "run": "corepack enable"
            },
            {
              "name": "tools",
              "uses": "taiki-e/install-action@cfdb7ed4ccc7c7dce37759eae89dc5674b469b39",
              "with": {
                "tool": "just@1.59.0,cargo-nextest@0.9.151,cargo-deny@0.20.2,cargo-llvm-cov@0.9.1"
              }
            },
            {
              "name": "cargo-mutants",
              "run": "node harness/ci/tools.mjs cargo-install"
            },
            {
              "name": "lefthook",
              "run": "node harness/ci/tools.mjs lefthook"
            },
            {
              "name": "fetch",
              "run": "node harness/ci/tools.mjs fetch"
            },
            {
              "name": "advisory db",
              "run": "just advisory-db-fetch"
            },
            {
              "name": "hooks",
              "run": "lefthook install"
            },
            {
              "name": "range",
              "id": "range",
              "run": "node harness/ci/ci-range.mjs base",
              "env": {
                "EVENT_NAME": "${{ github.event_name }}",
                "REF": "${{ github.ref }}",
                "BEFORE": "${{ github.event.before }}",
                "SHA": "${{ github.sha }}",
                "PR_BASE": "${{ github.event.pull_request.base.sha }}",
                "PR_HEAD": "${{ github.event.pull_request.head.sha }}"
              }
            },
            {
              "name": "just check",
              "run": "just base=\"$BASE\" check",
              "env": {
                "BASE": "${{ steps.range.outputs.base }}"
              }
            }
          ]
        },
        "notify": {
          "needs": ["linux", "macos"],
          "if": "failure() && github.event_name == 'push' && github.ref == 'refs/heads/master'",
          "runs-on": "ubuntu-24.04",
          "timeout-minutes": 10,
          "permissions": {
            "issues": "write"
          },
          "steps": [
            {
              "name": "base checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "ref": "${{ github.event.before }}",
                "path": "base-tools",
                "fetch-depth": 1,
                "persist-credentials": false
              }
            },
            {
              "name": "node",
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version-file": "base-tools/.node-version"
              }
            },
            {
              "name": "issue",
              "if": "hashFiles('base-tools/harness/ci/notify.mjs') != ''",
              "run": "node base-tools/harness/ci/notify.mjs",
              "env": {
                "GH_TOKEN": "${{ github.token }}",
                "TITLE": "CI 실패: master",
                "RUN_URL": "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}",
                "SHA": "${{ github.sha }}"
              }
            },
            {
              "name": "no notifier",
              "if": "hashFiles('base-tools/harness/ci/notify.mjs') == ''",
              "run": "echo '알림 없음: 기준 checkout에 harness/ci/notify.mjs가 없다'"
            }
          ]
        }
      }
    },
    ".github/workflows/nightly.yml": {
      "name": "nightly",
      "on": {
        "schedule": [
          {
            "cron": "0 18 * * *"
          }
        ]
      },
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "changes": {
          "runs-on": "ubuntu-24.04-arm",
          "timeout-minutes": 10,
          "outputs": {
            "changed": "${{ steps.changed.outputs.changed }}"
          },
          "steps": [
            {
              "name": "checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
