            {
              "name": "diff mutants verdict",
              "run": "node harness/ci/diff-mutants-verdict.mjs",
              "env": {
                "MUTATION_STATUS": "${{ steps.mutation.outputs.status }}"
              }
            }
          ]
        },
        "macos-branch": {
          "if": "github.event_name == 'push' && github.ref != 'refs/heads/master'",
          "runs-on": "macos-15",
          "timeout-minutes": 120,
          "steps": [
            {
              "name": "checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
