{
  "config": {
    "test": {
      "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "allowOnly": false,
      "passWithNoTests": true,
      "expect": {
        "requireAssertions": true
      },
      "unstubGlobals": true
    }
  },
  "cases": {
    "all-skipped": ["no-tests", "skipped"],
    "context-skip": ["skipped"],
    "describe-skip": ["skipped"],
    "describe-todo": ["skipped"],
    "empty-each": ["no-tests"],
    "empty-file": ["no-tests"],
    "empty-file-beside": ["no-tests"],
    "failing": ["failed", "no-tests"],
    "global-leak": [],
    "it-skip": ["skipped"],
    "it-todo": ["todo"],
    "no-assertion": ["failed"],
    "no-files": [],
    "only": ["failed", "no-tests", "skipped"],
    "outside-src": [],
    "passing": [],
    "run-if": ["skipped"],
    "skip-if": ["skipped"],
    "skip-option": ["skipped"]
  }
}
