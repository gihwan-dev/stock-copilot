{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "8"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(/harness/claude-hooks/lock.txt)",
      "Edit(/.claude/settings.local.json)",
      "Agent(fork)",
      "SendMessage",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude-*/projects/**)",
      "Read(~/.local/state/stock-copilot-harness/**)",
      "Workflow",
      "RemoteTrigger",
      "CronCreate",
      "mcp__t3-code__create_threads",
      "mcp__t3-code__t3_thread_launch",
      "mcp__t3-code__t3_thread_send",
      "mcp__t3-code__schedule_task",
      "mcp__t3-code__run_scheduled_task_now"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.mjs\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|SendMessage|mcp__t3[-_]code__delegate_task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-orchestration.mjs\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"",
            "timeout": 300,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-result.mjs\"",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "implementer|adversarial-reviewer|review-critic",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-start.mjs\"",
            "onFailure": "block",
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/implementer-stop.mjs\"",
            "timeout": 3600
          }
        ]
      },
      {
        "matcher": "adversarial-reviewer|review-critic",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reviewer-stop.mjs\"",
            "timeout": 300
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/config-change.mjs\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
